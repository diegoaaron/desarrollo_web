# Copia este archivo como .env.local para cambiar a qué backend llama `npm run dev`.
# Sin .env.local, el frontend usa el backend local (http://localhost:8082).
API_PROXY_TARGET=http://localhost:8082

# BACKEND_URL no va aquí: es la variable del proyecto en Vercel que lee vercel.mjs al
# desplegar (URL pública del backend, https://…, sin /api al final).
